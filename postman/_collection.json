{
  "info": {
    "name": "Printer Service API - Full Test",
    "_postman_id": "6d6d2f0a-9a0c-4c31-9f7f-printer-service-full",
    "description": "Full Postman collection for testing printer discovery, printer category routing, direct print, split kitchen print, and queue APIs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:9000",
      "type": "string"
    },
    {
      "key": "printerId",
      "value": "XP-80C",
      "type": "string"
    },
    {
      "key": "lanPrinterId",
      "value": "lan-192-168-100-100-9100",
      "type": "string"
    },
    {
      "key": "lanPrinterHost",
      "value": "192.168.100.100",
      "type": "string"
    },
    {
      "key": "lanPrinterPort",
      "value": "9100",
      "type": "string"
    },
    {
      "key": "lanPrinterName",
      "value": "May in bep",
      "type": "string"
    },
    {
      "key": "barPrinterId",
      "value": "lan-192-168-100-101-9100",
      "type": "string"
    },
    {
      "key": "barPrinterHost",
      "value": "192.168.100.101",
      "type": "string"
    },
    {
      "key": "barPrinterName",
      "value": "May in quay nuoc",
      "type": "string"
    },
    {
      "key": "kitchenCategoryId",
      "value": "mon-bep",
      "type": "string"
    },
    {
      "key": "drinkCategoryId",
      "value": "do-uong",
      "type": "string"
    },
    {
      "key": "failedJobId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "paymentQrUrl",
      "value": "http://s3.tppos.vn/nhahangha/company/payment_qr_1786680986981.png",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            },
            "description": "Check whether the printer service is running."
          }
        }
      ]
    },
    {
      "name": "Printers",
      "item": [
        {
          "name": "Get Printers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/printers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "printers"]
            },
            "description": "List Windows printers and configured LAN/TCP printer aliases. Configured printers return categoryIds when they have product category routing configured."
          }
        },
        {
          "name": "Discover LAN Printers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/printers/lan/discover",
              "host": ["{{baseUrl}}"],
              "path": ["api", "printers", "lan", "discover"]
            },
            "description": "Scan the current LAN and return IP addresses that expose printer ports configured in printers.json discovery.ports."
          }
        },
        {
          "name": "Discover LAN Printers - With Query",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/printers/lan/discover?subnetIp=192.168.100.1&netmask=255.255.255.0&concurrency=40&timeoutMs=300",
              "host": ["{{baseUrl}}"],
              "path": ["api", "printers", "lan", "discover"],
              "query": [
                { "key": "subnetIp", "value": "192.168.100.1" },
                { "key": "netmask", "value": "255.255.255.0" },
                { "key": "concurrency", "value": "40" },
                { "key": "timeoutMs", "value": "300" }
              ]
            },
            "description": "Scan LAN with explicit network options."
          }
        },
        {
          "name": "Test LAN Printer By IP - Kitchen",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"host\": \"{{lanPrinterHost}}\",\n  \"port\": {{lanPrinterPort}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/printers/lan/test",
              "host": ["{{baseUrl}}"],
              "path": ["api", "printers", "lan", "test"]
            },
            "description": "Send a test print directly to a LAN printer IP/port. This does not save config."
          }
        },
        {
          "name": "Save LAN Printer Alias - Kitchen (With Categories)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{lanPrinterId}}\",\n  \"name\": \"{{lanPrinterName}}\",\n  \"host\": \"{{lanPrinterHost}}\",\n  \"port\": {{lanPrinterPort}},\n  \"categoryIds\": [\"{{kitchenCategoryId}}\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/printers/lan/save",
              "host": ["{{baseUrl}}"],
              "path": ["api", "printers", "lan", "save"]
            },
            "description": "Save or update the kitchen LAN printer alias in printers.json. You can send categoryIds here directly; if omitted, existing categoryIds are preserved."
          }
        },
        {
          "name": "Update Printer Categories - Kitchen",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryIds\": [\"{{kitchenCategoryId}}\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/printers/{{lanPrinterId}}/categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "printers", "{{lanPrinterId}}", "categories"]
            },
            "description": "Configure which product categories this printer handles. Print routing scans printers[].categoryIds."
          }
        },
        {
          "name": "Save LAN Printer Alias - Bar (With Categories)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{barPrinterId}}\",\n  \"name\": \"{{barPrinterName}}\",\n  \"host\": \"{{barPrinterHost}}\",\n  \"port\": {{lanPrinterPort}},\n  \"categoryIds\": [\"{{drinkCategoryId}}\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/printers/lan/save",
              "host": ["{{baseUrl}}"],
              "path": ["api", "printers", "lan", "save"]
            },
            "description": "Optional second LAN printer alias for testing split jobs. This payload sends categoryIds directly."
          }
        },
        {
          "name": "Update Printer Categories - Bar",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryIds\": [\"{{drinkCategoryId}}\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/printers/{{barPrinterId}}/categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "printers", "{{barPrinterId}}", "categories"]
            },
            "description": "Configure the bar/drink printer for drink category routing."
          }
        },
        {
          "name": "Rename LAN Printer Alias",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{lanPrinterName}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/printers/lan/{{lanPrinterId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "printers", "lan", "{{lanPrinterId}}"]
            },
            "description": "Update the display name of a saved LAN printer alias."
          }
        },
        {
          "name": "Test Print - Direct Printer Id",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"printerId\": \"{{lanPrinterId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/printers/test",
              "host": ["{{baseUrl}}"],
              "path": ["api", "printers", "test"]
            },
            "description": "Send a simple test print to a Windows printer name, USB alias, or LAN alias."
          }
        },
        {
          "name": "Delete LAN Printer Alias",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/printers/lan/{{lanPrinterId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "printers", "lan", "{{lanPrinterId}}"]
            },
            "description": "Delete a saved LAN printer alias from printers.json. Use carefully after testing."
          }
        }
      ]
    },
    {
      "name": "Print",
      "item": [
        {
          "name": "Print Direct - Kitchen Ticket",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"printer\": \"{{lanPrinterId}}\",\n  \"template\": \"kitchen\",\n  \"data\": {\n    \"language\": \"vi\",\n    \"table\": \"B05\",\n    \"orderId\": \"ORD-DIRECT-001\",\n    \"orderNote\": \"In truc tiep theo printer id\",\n    \"items\": [\n      { \"name\": \"Pho bo\", \"qty\": 2, \"note\": \"Khong hanh\" },\n      { \"name\": \"Tra da\", \"qty\": 1 }\n    ]\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/print",
              "host": ["{{baseUrl}}"],
              "path": ["api", "print"]
            },
            "description": "Backward compatible path. If printer is present, the service prints directly and skips category routing."
          }
        },
        {
          "name": "Print Category - Top Level CategoryId",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": \"{{kitchenCategoryId}}\",\n  \"template\": \"kitchen\",\n  \"data\": {\n    \"language\": \"vi\",\n    \"table\": \"B05\",\n    \"orderId\": \"ORD-CAT-001\",\n    \"items\": [\n      { \"name\": \"Pho bo\", \"qty\": 2, \"note\": \"Khong hanh\" }\n    ]\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/print",
              "host": ["{{baseUrl}}"],
              "path": ["api", "print"]
            },
            "description": "Single-category routing. The service finds an enabled printer whose categoryIds contains categoryId."
          }
        },
        {
          "name": "Print Category Split - Kitchen And Bar",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"template\": \"kitchen\",\n  \"data\": {\n    \"language\": \"vi\",\n    \"table\": \"B05\",\n    \"orderId\": \"ORD-SPLIT-001\",\n    \"orderNote\": \"Test tach mon theo danh muc\",\n    \"items\": [\n      { \"categoryId\": \"{{kitchenCategoryId}}\", \"name\": \"Pho bo\", \"qty\": 2, \"note\": \"Khong hanh\" },\n      { \"categoryId\": \"{{drinkCategoryId}}\", \"name\": \"Tra da\", \"qty\": 1 }\n    ]\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/print",
              "host": ["{{baseUrl}}"],
              "path": ["api", "print"]
            },
            "description": "Main new flow. Items are grouped by item.categoryId, each category is resolved by scanning printers[].categoryIds, and multiple queue jobs may be created."
          }
        },
        {
          "name": "Print Category Split - Missing Category Error",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"template\": \"kitchen\",\n  \"data\": {\n    \"table\": \"B05\",\n    \"orderId\": \"ORD-MISSING-CAT-001\",\n    \"items\": [\n      { \"categoryId\": \"chua-cau-hinh\", \"name\": \"Mon chua cau hinh\", \"qty\": 1 }\n    ]\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/print",
              "host": ["{{baseUrl}}"],
              "path": ["api", "print"]
            },
            "description": "Expected 400 error: Danh muc chua cau hinh may in: chua-cau-hinh."
          }
        },
        {
          "name": "Print Bill - Direct",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"printer\": \"{{lanPrinterId}}\",\n  \"template\": \"bill\",\n  \"data\": {\n    \"storeName\": \"CUA HANG TEST\",\n    \"table\": \"05\",\n    \"items\": [\n      { \"name\": \"Pho bo\", \"qty\": 2, \"price\": 45000 },\n      { \"name\": \"Goi cuon\", \"qty\": 1, \"price\": 15000 }\n    ],\n    \"discount\": 5000,\n    \"tax\": 10000\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/print",
              "host": ["{{baseUrl}}"],
              "path": ["api", "print"]
            },
            "description": "Create a temporary bill print job by direct printer id."
          }
        },
        {
          "name": "Print Receipt - Direct",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"printer\": \"{{lanPrinterId}}\",\n  \"template\": \"receipt\",\n  \"data\": {\n    \"storeName\": \"CUA HANG TEST\",\n    \"orderId\": \"DH001\",\n    \"items\": [\n      { \"name\": \"Ca phe sua\", \"qty\": 2, \"price\": 25000 },\n      { \"name\": \"Banh mi\", \"qty\": 1, \"price\": 15000 }\n    ],\n    \"note\": \"Cam on quy khach\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/print",
              "host": ["{{baseUrl}}"],
              "path": ["api", "print"]
            },
            "description": "Create a receipt print job by direct printer id."
          }
        },
        {
          "name": "Print Label - Direct",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"printer\": \"{{lanPrinterId}}\",\n  \"template\": \"label\",\n  \"data\": {\n    \"productName\": \"Tra Sua Tran Chau\",\n    \"price\": 35000,\n    \"note\": \"It da, 50% duong\",\n    \"barcode\": \"893123456789\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/print",
              "host": ["{{baseUrl}}"],
              "path": ["api", "print"]
            },
            "description": "Create a product label print job by direct printer id."
          }
        },
        {
          "name": "Print Invoice - Top Level Payload Direct",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"printer\": \"{{lanPrinterId}}\",\n  \"template\": \"receipt\",\n  \"header\": {\n    \"store_name\": \"Nguyen Van Muoi\",\n    \"address\": \"269 Nguyen Van Huyen\",\n    \"phone\": \"01234567899888\"\n  },\n  \"branch_name\": \"main-branch\",\n  \"invoice\": {\n    \"title\": \"HOA DON BAN HANG\",\n    \"barcode\": {\n      \"type\": \"CODE128\",\n      \"value\": \"SAL-FYE-FC6F9A\"\n    },\n    \"qrcode\": {\n      \"value\": \"{{paymentQrUrl}}\"\n    },\n    \"code\": \"SAL-FYE-FC6F9A\",\n    \"created_at\": \"13/08/2026 16:36:09\",\n    \"customer\": \"Khach Le\",\n    \"seller\": \"0123456789\"\n  },\n  \"items\": [\n    {\n      \"name\": \"Cai bo thom\",\n      \"quantity\": 1,\n      \"unit_price\": 62000,\n      \"discount\": 50000,\n      \"amount\": 12000\n    }\n  ],\n  \"summary\": {\n    \"subtotal\": 12000,\n    \"discount\": 1200,\n    \"voucher\": 0,\n    \"points\": 10000,\n    \"tax\": 1377.34,\n    \"total\": 800\n  },\n  \"payment\": {\n    \"method\": \"cash\",\n    \"amount\": 800\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/print",
              "host": ["{{baseUrl}}"],
              "path": ["api", "print"]
            },
            "description": "Create a receipt job using top-level payload fields instead of data."
          }
        }
      ]
    },
    {
      "name": "Queue",
      "item": [
        {
          "name": "Get Queue",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/queue",
              "host": ["{{baseUrl}}"],
              "path": ["api", "queue"]
            },
            "description": "List all print jobs stored in SQLite. Split category jobs show printer/printerName as the resolved real printer id and may include categoryId."
          }
        },
        {
          "name": "Get Failed Queue",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/queue/failed",
              "host": ["{{baseUrl}}"],
              "path": ["api", "queue", "failed"]
            },
            "description": "List jobs that failed after all retry attempts. Failed jobs include lastError and original data payload."
          }
        },
        {
          "name": "Retry All Failed Jobs",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/queue/retry",
              "host": ["{{baseUrl}}"],
              "path": ["api", "queue", "retry"]
            },
            "description": "Retry all failed print jobs."
          }
        },
        {
          "name": "Retry One Failed Job",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{failedJobId}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/queue/retry",
              "host": ["{{baseUrl}}"],
              "path": ["api", "queue", "retry"]
            },
            "description": "Retry one failed print job by id. jobId is also accepted."
          }
        },
        {
          "name": "Clear Queue",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/queue",
              "host": ["{{baseUrl}}"],
              "path": ["api", "queue"]
            },
            "description": "Clear queued, completed, and failed jobs. Printing and spooled jobs are kept."
          }
        }
      ]
    }
  ]
}
