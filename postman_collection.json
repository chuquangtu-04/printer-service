      ]
    },
    {
      "name": "Queue",
      "item": [
        {
          "name": "Get Queue",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/queue",
              "host": ["{{baseUrl}}"],
              "path": ["api", "queue"]
            },
            "description": "List all print jobs stored in the SQLite queue. This endpoint keeps response light and does not include the original print payload."
          }
        },
        {
          "name": "Get Failed Queue",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/queue/failed",
              "host": ["{{baseUrl}}"],
              "path": ["api", "queue", "failed"]
            },
            "description": "List jobs that failed after all retry attempts. Failed jobs include lastError and the original data payload for FE display."
          }
        },
        {
          "name": "Retry All Failed Jobs",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/queue/retry",
              "host": ["{{baseUrl}}"],
              "path": ["api", "queue", "retry"]
            },
            "description": "Retry all failed print jobs."
          }
        },
        {
          "name": "Retry One Failed Job",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{failedJobId}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/queue/retry",
              "host": ["{{baseUrl}}"],
              "path": ["api", "queue", "retry"]
            },
            "description": "Retry one failed print job by id. jobId is also accepted."
          }
        },
        {
          "name": "Clear Queue",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/queue",
              "host": ["{{baseUrl}}"],
              "path": ["api", "queue"]
            },
            "description": "Clear queued, completed, and failed jobs. Printing and spooled jobs are kept."
          }
        }
      ]
    }
  ]
}
