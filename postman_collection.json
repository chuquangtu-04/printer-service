                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"printer\": \"{{printerId}}\",\n  \"template\": \"receipt\",\n  \"data\": {\n    \"storeName\": \"CUA HANG TEST\",\n    \"orderId\": \"DH001\",\n    \"items\": [\n      { \"name\": \"Ca phe sua\", \"qty\": 2, \"price\": 25000 },\n      { \"name\": \"Banh mi\", \"qty\": 1, \"price\": 15000 }\n    ],\n    \"note\": \"Cam on quy khach\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/print",
              "host": ["{{baseUrl}}"],
              "path": ["api", "print"]
            },
            "description": "Create a receipt print job."
          }
        },
        {
          "name": "Print Kitchen Ticket",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"printer\": \"{{printerId}}\",\n  \"template\": \"kitchen\",\n  \"data\": {\n    \"language\": \"vi\",\n    \"table\": \"B05\",\n    \"orderId\": \"ORD-001\",\n    \"orderNote\": \"Khach can gap\",\n    \"items\": [\n      { \"name\": \"Pho bo\", \"qty\": 2, \"note\": \"Khong hanh\" },\n      { \"name\": \"Tra da\", \"qty\": 1 }\n    ]\n  }\n}"
