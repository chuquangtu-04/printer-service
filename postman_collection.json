  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:9000",
      "type": "string"
    },
    {
      "key": "printerId",
      "value": "XP-80C",
      "type": "string"
    },
    {
      "key": "lanPrinterId",
      "value": "kitchen-01",
      "type": "string"
    },
    {
      "key": "failedJobId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "paymentQrUrl",
      "value": "http://s3.tppos.vn/nhahangha/company/payment_qr_1786680986981.png",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            },
            "description": "Check whether the printer service is running."
          }
        }
      ]
    },
    {
      "name": "Printers",
      "item": [
        {
          "name": "Get Printers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/printers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "printers"]
            },
            "description": "List Windows printers and configured LAN/USB aliases."
          }
        },
        {
          "name": "Test Print",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"printerId\": \"{{printerId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/printers/test",
              "host": ["{{baseUrl}}"],
              "path": ["api", "printers", "test"]
            },
            "description": "Send a simple test print to a Windows printer name, USB alias, or LAN alias."
          }
        },
        {
          "name": "Test Print - LAN Alias",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"printerId\": \"{{lanPrinterId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/printers/test",
              "host": ["{{baseUrl}}"],
              "path": ["api", "printers", "test"]
            },
            "description": "Send a simple test print to the LAN printer alias from config/printers.json."
          }
        }
      ]
    },
    {
      "name": "Print",
      "item": [
        {
          "name": "Print Receipt",
          "request": {
            "method": "POST",
            "header": [
