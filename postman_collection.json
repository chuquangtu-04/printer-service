              "raw": "{\n  \"printer\": \"{{printerId}}\",\n  \"template\": \"label\",\n  \"data\": {\n    \"productName\": \"Tra Sua Tran Chau\",\n    \"price\": 35000,\n    \"note\": \"It da, 50% duong\",\n    \"barcode\": \"893123456789\"\n  }\n}"
